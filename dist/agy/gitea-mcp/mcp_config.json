{
  "mcpServers": {
    "gitea": {
      "command": "go",
      "args": [
        "run",
        "gitea.com/gitea/gitea-mcp@latest",
        "-t",
        "stdio"
      ],
      "env": {
        "GITEA_HOST": "${GITEA_HOST}",
        "GITEA_ACCESS_TOKEN": "${GITEA_ACCESS_TOKEN}"
      }
    }
  }
}
